{
  "functions": {
    "api/chat.js": {
      "includeFiles": "profile.md"
    }
  },
  "rewrites": [
    {
      "source": "/blog",
      "destination": "https://library.kashifriyaz.com/blog"
    },
    {
      "source": "/blog/",
      "destination": "https://library.kashifriyaz.com/blog"
    },
    {
      "source": "/blog/:slug",
      "destination": "https://library.kashifriyaz.com/blog/:slug"
    },
    {
      "source": "/projects",
      "destination": "https://library.kashifriyaz.com/projects"
    },
    {
      "source": "/projects/",
      "destination": "https://library.kashifriyaz.com/projects"
    },
    {
      "source": "/projects/:slug",
      "destination": "https://library.kashifriyaz.com/projects/:slug"
    },
    {
      "source": "/library",
      "destination": "https://library.kashifriyaz.com/library"
    },
    {
      "source": "/library/",
      "destination": "https://library.kashifriyaz.com/library"
    },
    {
      "source": "/library/:path+/",
      "destination": "https://library.kashifriyaz.com/library/:path+"
    },
    {
      "source": "/library/:path*",
      "destination": "https://library.kashifriyaz.com/library/:path*"
    },
    {
      "source": "/tools",
      "destination": "https://library.kashifriyaz.com/tools"
    },
    {
      "source": "/tools/",
      "destination": "https://library.kashifriyaz.com/tools"
    },
    {
      "source": "/tools/:path+/",
      "destination": "https://library.kashifriyaz.com/tools/:path+"
    },
    {
      "source": "/tools/:path*",
      "destination": "https://library.kashifriyaz.com/tools/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://library.kashifriyaz.com/_next/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://library.kashifriyaz.com/sitemap.xml"
    }
  ]
}
