{
  "functions": { "api/chat.js": { "includeFiles": "profile.md" } },
  "rewrites": [
    { "source": "/blog", "destination": "https://library.kashifriyaz.com/blog" },
    { "source": "/blog/", "destination": "https://library.kashifriyaz.com/blog" },
    { "source": "/blog/:slug", "destination": "https://library.kashifriyaz.com/blog/:slug" },
    { "source": "/projects", "destination": "https://library.kashifriyaz.com/projects" },
    { "source": "/projects/", "destination": "https://library.kashifriyaz.com/projects" },
    { "source": "/_next/:path*", "destination": "https://library.kashifriyaz.com/_next/:path*" }
  ]
}
